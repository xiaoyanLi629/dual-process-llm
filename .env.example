# Copy this file to .env and fill in your keys. The real .env is gitignored.
#
# Recommended: use OpenRouter (https://openrouter.ai/keys) as a single endpoint
# that serves OpenAI, DeepSeek, Qwen, and Llama with one key.

# --- OpenRouter (serves all families via OpenAI-compatible endpoint) ---
OPENAI_API_KEY=sk-or-v1-...
OPENAI_API_BASE=https://openrouter.ai/api/v1
MODEL_PREFIX=openai/
USE_OPENROUTER=1

# --- Direct provider keys (only if you prefer not to use OpenRouter) ---
# DEEPSEEK_API_KEY=sk-...
# TOGETHER_API_KEY=...
# DASHSCOPE_API_KEY=sk-...
# GROQ_API_KEY=gsk_...
# HUGGINGFACE_TOKEN=hf_...
